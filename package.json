{
  "name": "codepup",
  "productName": "CodePup",
  "version": "2.7.2",
  "description": "여러 Claude Code 세션을 지켜보다가 끝나거나 허락이 필요하면 달려와 알려 주는 데스크톱 펫 (메뉴 막대 시스템 모니터 포함)",
  "main": "src/main/main.js",
  "author": "madirony",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/madirony/codepup.git"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "pixi.js": "7.4.3",
    "systeminformation": "^5.33.13"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.madirony.codepup",
    "productName": "CodePup",
    "copyright": "© madirony",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "Claude Code 세션이 돌아가는 터미널 창으로 이동하고, 닫힌 세션을 터미널 탭으로 다시 열기 위해 필요해요."
      }
    },
    "dmg": {
      "title": "CodePup ${version}",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
